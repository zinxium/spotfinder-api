# ============================================
# SPOTFINDER API - Template Variables d'Environnement
# ============================================
# Copiez ce fichier vers .env et remplissez les valeurs

# ============================================
# SÉCURITÉ (OBLIGATOIRE)
# ============================================
SECRET_KEY=your-secret-key-here

# ============================================
# JWT (optionnel)
# ============================================
# Clé de signature des tokens (défaut: SECRET_KEY). La changer invalide tous les tokens.
# JWT_SIGNING_KEY=another-long-random-secret
# Durée de vie du token d'accès (minutes) et du refresh token (jours)
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# ============================================
# LIMITATION DE DÉBIT (optionnel)
# ============================================
THROTTLE_ANON=100/minute
THROTTLE_USER=300/minute
# Connexion / inscription / refresh, par adresse IP
THROTTLE_AUTH=10/minute

# ============================================
# DÉVELOPPEMENT (OBLIGATOIRE)
# ============================================
DEBUG=True

# ============================================
# HÔTES AUTORISÉS (OBLIGATOIRE)
# ============================================
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# ============================================
# BASE DE DONNÉES POSTGRESQL
# ============================================
# Option 1 (Recommandé pour production) : DATABASE_URL
# Exemple: postgresql://user:password@host:5432/dbname
# DATABASE_URL=postgresql://spotfinder_root:password@localhost:5432/spotfinder_db

# Option 2 (Développement) : Credentials individuels
# ⚠️ DB_PASSWORD est OBLIGATOIRE en production (pas de valeur par défaut)
DB_NAME=spotfinder_db
DB_USER=spotfinder_user
DB_PASSWORD=your_secure_password
DB_HOST=localhost
DB_PORT=5432

# ============================================
# EMAIL (optionnel)
# ============================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# ============================================
# API EXTERNES (optionnel)
# ============================================
GOOGLE_MAPS_API_KEY=your-google-maps-key
WEATHER_API_KEY=your-weather-api-key

# ============================================
# STOCKAGE (optionnel)
# ============================================
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_STORAGE_BUCKET_NAME=your-bucket-name

# ============================================
# STOCKAGE CLOUDINARY (alternative à AWS S3)
# ============================================
USE_CLOUDINARY=False
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ============================================
# LOGGING (optionnel)
# ============================================
LOG_LEVEL=INFO

# ============================================
# INTERNATIONALISATION ET LOCALISATION
# ============================================
LANGUAGE_CODE=en-us
TIME_ZONE=UTC

# ============================================
# FICHIERS STATIQUES
# ============================================
STATIC_URL=static/
STATIC_ROOT=staticfiles

# ============================================
# API DOCUMENTATION (SWAGGER)
# ============================================
API_TITLE=SpotFinder API
API_DESCRIPTION=API REST pour SpotFinder - Trouvez et partagez vos lieux préférés
# La version vient de spotfinderapi/__init__.py (__version__), pas du .env
API_CONTACT_NAME=SpotFinder Support
API_CONTACT_EMAIL=support@spotfinder.com
API_LICENSE_NAME=MIT License

# ============================================
# CORS - Cross-Origin Resource Sharing
# ============================================
# Domaines autorisés pour les requêtes cross-origin (séparés par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
# Inutile avec le JWT (envoyé dans l'en-tête Authorization, pas en cookie)
CORS_ALLOW_CREDENTIALS=False

# ============================================
# SÉCURITÉ - PRODUCTION (Render, Heroku, etc.)
# ============================================
# Redirection en HTTPS (False en développement, True en production)
SECURE_SSL_REDIRECT=False

# Faire confiance à l'en-tête X-Forwarded-Proto du proxy (Render, Heroku…).
# True derrière un proxy HTTPS (sinon boucle de redirection), False sinon.
TRUST_PROXY_SSL_HEADER=True

# Sécuriser les cookies (False en développement, True en production)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# HSTS - HTTP Strict Transport Security (en production)
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Politique de référence
SECURE_REFERRER_POLICY=strict-origin-when-cross-origin

# X-Frame-Options
X_FRAME_OPTIONS=DENY

# ============================================
# WHITENOISE - Configuration fichiers statiques
# ============================================
WHITENOISE_AUTOREFRESH=False

# ============================================
# AUTRES
# ============================================
BASE_URL=http://localhost:8000