# ============================================
# SPOTFINDER API - Template Variables d'Environnement
# ============================================
# Copiez ce fichier vers .env et remplissez les valeurs

# ============================================
# SÉCURITÉ (OBLIGATOIRE)
# ============================================
SECRET_KEY=your-secret-key-here

# ============================================
# DÉVELOPPEMENT (OBLIGATOIRE)
# ============================================
DEBUG=True

# ============================================
# HÔTES AUTORISÉS (OBLIGATOIRE)
# ============================================
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# ============================================
# BASE DE DONNÉES POSTGRESQL
# ============================================
DB_NAME=spotfinder_db
DB_USER=spotfinder_user
DB_PASSWORD=your_secure_password
DB_HOST=localhost
DB_PORT=5432

# Alternative : DATABASE_URL (pour dj-database-url)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# ============================================
# EMAIL (optionnel)
# ============================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# ============================================
# API EXTERNES (optionnel)
# ============================================
GOOGLE_MAPS_API_KEY=your-google-maps-key
WEATHER_API_KEY=your-weather-api-key

# ============================================
# STOCKAGE (optionnel)
# ============================================
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_STORAGE_BUCKET_NAME=your-bucket-name

# ============================================
# STOCKAGE CLOUDINARY (alternative à AWS S3)
# ============================================
USE_CLOUDINARY=False
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ============================================
# LOGGING (optionnel)
# ============================================
LOG_LEVEL=INFO

# ============================================
# INTERNATIONALISATION ET LOCALISATION
# ============================================
LANGUAGE_CODE=en-us
TIME_ZONE=UTC

# ============================================
# FICHIERS STATIQUES
# ============================================
STATIC_URL=static/
STATIC_ROOT=staticfiles

# ============================================
# API DOCUMENTATION (SWAGGER)
# ============================================
API_TITLE=SpotFinder API
API_DESCRIPTION=API REST pour SpotFinder - Trouvez et partagez vos lieux préférés
API_VERSION=1.0.0
API_CONTACT_NAME=SpotFinder Support
API_CONTACT_EMAIL=support@spotfinder.com
API_LICENSE_NAME=MIT License

# ============================================
# CORS - Cross-Origin Resource Sharing
# ============================================
# Domaines autorisés pour les requêtes cross-origin (séparés par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=True

# ============================================
# SÉCURITÉ - PRODUCTION (Render, Heroku, etc.)
# ============================================
# Redirection en HTTPS (False en développement, True en production)
SECURE_SSL_REDIRECT=False

# Sécuriser les cookies (False en développement, True en production)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# HSTS - HTTP Strict Transport Security (en production)
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Politique de référence
SECURE_REFERRER_POLICY=strict-origin-when-cross-origin

# X-Frame-Options
X_FRAME_OPTIONS=DENY

# ============================================
# WHITENOISE - Configuration fichiers statiques
# ============================================
WHITENOISE_AUTOREFRESH=False

# ============================================
# AUTRES
# ============================================
BASE_URL=http://localhost:8000